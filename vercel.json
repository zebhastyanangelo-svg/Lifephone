{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "devCommand": "vite",
  "installCommand": "npm install",
  "framework": "vite",
  "regions": ["iad1"],
  "env": {
    "VITE_SUPABASE_URL": "https://fdsiutxsduuzayfmgocd.supabase.co",
    "VITE_SUPABASE_ANON_KEY": "sb_publishable_MgjKh8SvwIiGuhP3CHboxA_rlhjRBoI"
  },
  "cleanUrls": false,
  "rewrites": [
    { "source": "/(.*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
